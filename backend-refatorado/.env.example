# Copie este arquivo para .env e ajuste os valores.

# Postgres (usado pelo docker-compose.yml e pelo application.yml)
POSTGRES_DB=achados_e_devolvidos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DB_URL=jdbc:postgresql://localhost:5432/achados_e_devolvidos
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT - gere um valor com: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# OAuth2 (Google) - crie um client em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:5173/login?erro=oauth2

# E-mail (SMTP) - usado pelo fluxo de esqueci-minha-senha. Defaults apontam para
# o sandbox do Mailtrap (https://mailtrap.io) - crie uma inbox gratuita em
# Email Testing > Inboxes e pegue usuário/senha em "SMTP Settings".
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# Link de redefinição de senha enviado por e-mail (?token=... é anexado
# automaticamente) e validade do token, em minutos.
PASSWORD_RESET_REDIRECT_URI=http://localhost:5173/reset-password
PASSWORD_RESET_EXPIRATION_MINUTES=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
